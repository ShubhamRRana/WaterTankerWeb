# App store links (for download badges on landing/about)
VITE_APP_STORE_URL=https://apps.apple.com/app/your-app-id
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.watertanker.app
VITE_ADMIN_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.watertanker.admin

# Supabase (for contact form) — see SUPABASE_SETUP.md
# Get from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: secret for contact-form Edge Function (set same value in Supabase → Edge Functions → send-contact-email → Secrets as CONTACT_WEBHOOK_SECRET)
# VITE_CONTACT_WEBHOOK_SECRET=your-secret
